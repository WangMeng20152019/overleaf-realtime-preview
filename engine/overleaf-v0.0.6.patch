+#[cfg(test)]
+mod capture_revision_tests {
+    use super::*;
+
+    thread_local! {
+        static AFTER_INSTALL: std::cell::RefCell<Option<Box<dyn FnOnce(&Shared)>>> =
+            std::cell::RefCell::new(None);
+    }
+    pub(super) fn after_install(s: &Shared) {
+        AFTER_INSTALL.with(|hook| { if let Some(run) = hook.borrow_mut().take() { run(s); } });
+    }
+
+    #[test]
+    fn superseded_capture_keeps_replay_baseline_then_converges_after_idle() {
+        crate::texlive::TexLive::discover().expect("LuaLaTeX required for capture revision regression");
+        let root = std::env::temp_dir().join(format!("rtex-capture-revision-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let text = "\\documentclass{article}\n\\begin{document}\nAlpha stable paragraph.\n\nBeta stable paragraph.\n\\end{document}\n";
+        std::fs::write(root.join("main.tex"), text).unwrap();
+        let mut cfg = SessionConfig::new(&root, "main.tex");
+        cfg.build_dir = root.join("build");
+        cfg.debounce = Duration::from_millis(25);
+        let session = Session::open(cfg).unwrap();
+        let (first, _) = session.wait_for(Duration::from_secs(30), |e| matches!(e,
+            Event::LayoutUpdate { compile: CompileStatus::Ok, convergence: Convergence::Converged, .. }));
+        assert!(first.is_some(), "initial capture missing");
+        session.pause_background(true);
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while session.shared.bg_running.load(Ordering::SeqCst) && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        assert!(!session.shared.bg_running.load(Ordering::SeqCst));
+        let (_, spans, captured_rev) = snapshot(&session.shared);
+        let dir = session.shared.last_pass_dir.lock().clone().unwrap();
+        let mut json: crate::capture::CaptureJson = serde_json::from_str(
+            &std::fs::read_to_string(dir.join("main.rtex.json")).unwrap()).unwrap();
+        json.finalize();
+        let cap = crate::capture::CaptureResult { out_dir: dir.clone(), jobname: "main".into(),
+            json, pdf: dir.join("main.pdf"), log: dir.join("main.log"),
+            wall: Duration::ZERO, exit_ok: true };
+        // Deterministic post-install latch: a new-layout live result arriving
+        // after the installation locks release must survive warm-up scheduling.
+        // The former late on_new_layout call erased this exact marker.
+        AFTER_INSTALL.with(|hook| *hook.borrow_mut() = Some(Box::new(|s| {
+            s.live.lock().unit(ParaId(999_999)).rows = Some(3);
+        })));
+        deliver_layout(&session.shared, Instant::now(), &cap, 1, true, spans.clone(), captured_rev, false);
+        assert_eq!(session.shared.live.lock().get(ParaId(999_999)).and_then(|u| u.rows), Some(3),
+            "new-layout live result was erased after installation locks released");
+        let before = session.versions();
+        let at = text.find("Beta").unwrap();
+        let result = session.apply_edit("main.tex", Edit { start_byte: at, end_byte: at,
+            text: "New inserted paragraph.\n\n".into() }).unwrap();
+        let failed = ParaId(999_998);
+        session.shared.live.lock().quarantine(failed, 1, captured_rev);
+        session.shared.fast_failures.lock().insert(failed, captured_rev);
+        deliver_layout(&session.shared, Instant::now(), &cap, 1, true, spans, captured_rev, false);
+        assert_eq!(session.shared.live.lock().get(failed).and_then(|u| u.crash).map(|c| c.clean_pass), Some(false),
+            "obsolete clean capture granted quarantine recovery without installing a replay baseline");
+        assert!(session.shared.fast_failures.lock().contains_key(&failed),
+            "obsolete capture withdrew live diagnostics although it was not admitted");
+        let after = session.versions();
+        assert_eq!(after.layout_version, before.layout_version, "stale capture changed layout");
+        assert_eq!(after.context_revision, before.context_revision, "stale capture changed replay context");
+        session.pause_background(false);
+        let (latest, _) = session.wait_for(Duration::from_secs(30), |e| matches!(e,
+            Event::LayoutUpdate { versions, compile: CompileStatus::Ok, .. }
+                if versions.source_revision == result.source_revision));
+        assert!(latest.is_some(), "idle source did not receive a matching full capture");
+        assert!(session.document_text("main.tex").unwrap().contains("New inserted paragraph."));
+        session.close();
+        std::fs::remove_dir_all(root).unwrap();
+    }
