+#[cfg(test)]
+mod revision_lock_tests {
+    use super::*;
+    thread_local! {
+        static MUTATION_ATTEMPT: std::cell::RefCell<Option<std::sync::mpsc::Sender<()>>> =
+            std::cell::RefCell::new(None);
+    }
+    pub(super) fn before_mutation_lock() {
+        MUTATION_ATTEMPT.with(|hook| { if let Some(tx) = hook.borrow_mut().take() { tx.send(()).unwrap(); } });
+    }
+    #[test]
+    fn source_revision_and_mutation_share_snapshot_lock() {
+        crate::texlive::TexLive::discover().expect("LuaLaTeX required for revision-lock regression");
+        let root = std::env::temp_dir().join(format!("rtex-source-revision-lock-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let source = "\\documentclass{article}\n\\begin{document}\nAlpha stable paragraph.\n\nBeta stable paragraph.\n\\end{document}\n";
+        std::fs::write(root.join("main.tex"), source).unwrap();
+        let mut cfg = SessionConfig::new(&root, "main.tex");
+        cfg.build_dir = root.join("build");
+        let session = Session::open(cfg).unwrap();
+        let (initial, _) = session.wait_for(Duration::from_secs(30), |e| matches!(e,
+            Event::LayoutUpdate { compile: CompileStatus::Ok, convergence: Convergence::Converged, .. }));
+        assert!(initial.is_some());
+        session.pause_background(true);
+        for new_file in [false, true] {
+            let guard = session.shared.files.lock();
+            let before = session.shared.source_revision.load(Ordering::SeqCst);
+            let (tx, rx) = std::sync::mpsc::channel();
+            std::thread::scope(|scope| {
+                let worker = scope.spawn(|| {
+                    MUTATION_ATTEMPT.with(|hook| *hook.borrow_mut() = Some(tx));
+                    if new_file { session.set_document("extra.tex", "Extra source.") }
+                    else { session.apply_edit("main.tex", Edit { start_byte: source.find("Alpha").unwrap(), end_byte: source.find("Alpha").unwrap(), text: "New ".into() }) }
+                });
+                rx.recv_timeout(Duration::from_secs(5)).unwrap();
+                // Worker reached the mutation lock while snapshot owns it.
+                let while_locked = session.shared.source_revision.load(Ordering::SeqCst);
+                drop(guard);
+                let result = worker.join().unwrap().unwrap();
+                assert_eq!(while_locked, before,
+                    "revision advanced while source was still blocked by snapshot");
+                let (texts, _, revision) = passes::snapshot(&session.shared);
+                assert_eq!(revision, result.source_revision);
+                assert!(if new_file { texts["extra.tex"] == "Extra source." }
+                    else { texts["main.tex"].contains("New Alpha") });
+            });
+        }
+        let before = session.shared.source_revision.load(Ordering::SeqCst);
+        let current = session.document_text("main.tex").unwrap();
+        for (start, end) in [(2, 1), (current.len() + 1, current.len() + 1)] {
+            assert!(session.apply_edit("main.tex", Edit { start_byte: start, end_byte: end, text: "x".into() }).is_err());
+            assert_eq!(session.shared.source_revision.load(Ordering::SeqCst), before);
+            assert_eq!(session.document_text("main.tex").unwrap(), current);
+        }
+        assert!(session.set_document("../outside.tex", "x").is_err());
+        assert_eq!(session.shared.source_revision.load(Ordering::SeqCst), before);
+        assert!(session.apply_edit("missing.tex", Edit { start_byte: 0, end_byte: 0, text: "x".into() }).is_err());
+        assert_eq!(session.shared.source_revision.load(Ordering::SeqCst), before);
+        session.close();
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
